    {
        "id": "463396bfb6c89459",
        "type": "function",
        "z": "dae92552c0cc9cde",
        "name": "Identify Package",
        "func": "let uid = msg.payload.toString().trim();\n\nlet type = \"UNKNOWN CARD\";\n\nif (uid === \"7378BD02\") {\n    type = \"PACKAGE CARD\";\n}\nelse if (uid === \"B359B834\") {\n    type = \"DRIVER CARD\";\n}\n\nflow.set(\"lastNFC\", uid);\n\nmsg.payload = uid + \" - \" + type;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 490,
        "y": 160,
        "wires": [
            [
                "3113894241b45c7e"
            ]
        ]
    },
    {
        "id": "33910e200a01e640",
        "type": "function",
        "z": "dae92552c0cc9cde",
        "name": "Package Presence",
        "func": "let value = msg.payload.toString().trim();\n\nlet present = value === \"true\";\n\nflow.set(\"packagePresent\", present);\n\nmsg.payload = present ? \"PACKAGE PRESENT\" : \"PACKAGE MISSing\";\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 490,
        "y": 240,
        "wires": [
            [
                "55439231a5670d74"
            ]
        ]
    },
    {
        "id": "2fd1c5e6893333ba",
        "type": "function",
        "z": "dae92552c0cc9cde",
        "name": "Delivery State Manager",
        "func": "// ==========================================\n// DELIVERY STATE MANAGER\n// ==========================================\n\n// Current state\nlet status = global.get(\"packageStatus\") || \"WAITING_FOR_DRIVER\";\n\n// Package ID\nlet packageId = flow.get(\"package_id\") || \"PACKAGE_102\";\n\n// Event from Raspberry Pi\nlet event = msg.payload.toString().trim();\n\n\n// ==========================================\n// OUTPUTS\n// ==========================================\n\n// 1 → Telegram\n// 2 → Gmail\n// 3 → Dashboard\n// 4 → Status MQTT\n\nlet outTelegram = null;\nlet outGmail = null;\nlet outDashboard = null;\nlet outStatus = null;\n\n\n// ==========================================\n// AUTHORIZED DRIVER\n// ==========================================\n\nif (event === \"AUTHORIZED_DRIVER\") {\n\n    status = \"WAITING_FOR_PACKAGE\";\n\n    node.warn(\"Authorized driver detected.\");\n\n}\n\n\n// ==========================================\n// PACKAGE LOADED\n// ==========================================\n\nelse if (event === \"PACKAGE_LOADED\") {\n\n    status = \"IN_TRANSIT\";\n\n    node.warn(\"Package loaded successfully.\");\n\n}\n\n\n// ==========================================\n// DELIVERY STARTED\n// ==========================================\n\nelse if (event === \"DELIVERY_STARTED\") {\n\n    status = \"IN_TRANSIT\";\n\n    node.warn(\"Delivery started.\");\n\n    // Telegram notification\n    outTelegram = {\n        payload: {\n            chatId: \"1212440511\",\n            type: \"message\",\n            content:\n                \"🚚 Package \" +\n                packageId +\n                \" has started its delivery journey.\"\n        }\n    };\n}\n\n\n// ==========================================\n// DRIVER ARRIVED\n// ==========================================\n\nelse if (event === \"DRIVER_ARRIVED\") {\n\n    status = \"ARRIVED\";\n\n    node.warn(\"Driver arrived at destination.\");\n\n    // Telegram notification\n    outTelegram = {\n        payload: {\n            chatId: \"1212440511\",\n            type: \"message\",\n            content:\n                \"📦 Package \" +\n                packageId +\n                \" has arrived at the destination.\"\n        }\n    };\n}\n\n\n// ==========================================\n// DELIVERED\n// ==========================================\n\nelse if (event === \"DELIVERED\") {\n\n    status = \"DELIVERED\";\n\n    node.warn(\"Package delivered successfully.\");\n\n    // Telegram\n    outTelegram = {\n        payload: {\n            chatId: \"1212440511\",\n            type: \"message\",\n            content:\n                \"✅ Package \" +\n                packageId +\n                \" has been delivered successfully.\"\n        }\n    };\n}\n\n\n// ==========================================\n// UNAUTHORIZED ACCESS\n// ==========================================\n\nelse if (event === \"UNAUTHORIZED_ACCESS\") {\n\n    status = \"SECURITY_ALERT\";\n\n    node.warn(\"SECURITY ALERT: Unauthorized access.\");\n\n    // Gmail\n    outGmail = {\n        to: \"sherymegally@gmail.com\",\n        topic: \"CRITICAL SECURITY ALERT\",\n        payload:\n            \"Unauthorized access detected for package \" +\n            packageId +\n            \".\"\n    };\n}\n\n\n// ==========================================\n// MISSING PACKAGE\n// ==========================================\n\nelse if (event === \"MISSING_PACKAGE\") {\n\n    status = \"SECURITY_ALERT\";\n\n    node.warn(\"SECURITY ALERT: Package missing.\");\n\n    // Gmail\n    outGmail = {\n        to: \"sherymegally@gmail.com\",\n        topic: \"PACKAGE MISSING\",\n        payload:\n            \"Package \" +\n            packageId +\n            \" is missing.\"\n    };\n}\n\n\n// ==========================================\n// SAVE STATE\n// ==========================================\n\nglobal.set(\"packageStatus\", status);\n\n\n// ==========================================\n// DASHBOARD DATA\n// ==========================================\n\noutDashboard = {\n\n    payload: {\n\n        package_id: packageId,\n\n        event: event,\n\n        status: status,\n\n        timestamp: new Date().toLocaleString()\n\n    }\n\n};\n\n\n// ==========================================\n// STATUS MQTT\n// ==========================================\n\noutStatus = {\n\n    topic: \"delivery/status\",\n\n    payload: JSON.stringify({\n\n        package_id: packageId,\n\n        event: event,\n\n        status: status,\n\n        timestamp: new Date().toISOString()\n\n    })\n\n};\n\n\n// ==========================================\n// NODE-RED STATUS\n// ==========================================\n\nnode.status({\n\n    fill:\n        status === \"SECURITY_ALERT\"\n            ? \"red\"\n            : status === \"DELIVERED\"\n                ? \"green\"\n                : \"blue\",\n\n    shape: \"dot\",\n\n    text:\n        packageId +\n        \" → \" +\n        status\n\n});\n\n\n// ==========================================\n// RETURN 4 OUTPUTS\n// ==========================================\n//\n// 1 → Telegram\n// 2 → Gmail\n// 3 → Dashboard\n// 4 → MQTT status\n//\n\nreturn [\n\n    outTelegram,\n\n    outGmail,\n\n    outDashboard,\n\n    outStatus\n\n];\n\n",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
